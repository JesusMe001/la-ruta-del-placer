# Base de datos
DATABASE_URL="postgresql://lilax_user:CAMBIAR@localhost:5432/lilax_db?schema=public"

# JWT (login de cajera/admin)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Sincronización con el sistema central de La Ruta del Placer
# Se define en cuanto su equipo entregue el endpoint y la ruta de red (VPN/whitelist).
CENTRAL_SYNC_URL=""
CENTRAL_SYNC_API_KEY=""

PORT=3000

# Restricción de red para el menú del huésped (/qr/*): solo IPs dentro de
# estos rangos pueden pedir consumo o ver su cuenta. Por defecto cubre las
# redes privadas estándar (10.x, 172.16-31.x, 192.168.x) + localhost.
# Si el wifi del hotel usa un rango distinto, ajústalo aquí, ej.:
# ALLOWED_NETWORKS=192.168.1.0/24
ALLOWED_NETWORKS=

# Poner en "true" SOLO si hay un reverse proxy (nginx) real delante de la API
# en producción — necesario para que el guard de red vea la IP real del
# cliente en vez de la del proxy. También si se publica por Cloudflare
# Tunnel: el guard usará el header CF-Connecting-IP. En ese caso agrega la
# IP PÚBLICA del hotel a las redes permitidas (los huéspedes en el wifi salen
# a internet con esa IP) y no expongas el puerto 3000 directamente.
TRUST_PROXY=false

# Tarjeta de fidelización (Google Wallet) — opcional. Sin esto, el admin
# puede parametrizar el contenido de la tarjeta igual, pero el botón
# "Agregar a Google Wallet" no va a generar un enlace real hasta que
# se complete esta configuración con las credenciales del emisor.
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=lilax_v1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# URL pública HTTPS donde Google puede descargar el logo/imagen de la tarjeta
# (el dominio del frontend en producción, ej. https://lilax.larutadelplacer.ec)
PUBLIC_ASSETS_BASE_URL=

# Integración de solo lectura con el ERP Informix existente. Requiere el IBM
# Informix Client SDK para Linux instalado en el servidor (no se puede
# empaquetar por licencia — ver README.md). Mientras no esté configurado,
# el módulo simplemente reporta "no disponible" sin romper el resto del sistema.
INFORMIX_ENABLED=false

# Opción A: usar un DSN ya registrado en /etc/odbc.ini del servidor Linux
# (mismos parámetros que el DSN "HOTELES" que ya funciona en Windows)
INFORMIX_DSN=
INFORMIX_UID=
INFORMIX_PWD=

# Opción B: conexión directa sin DSN preconfigurado (dejar INFORMIX_DSN vacío)
INFORMIX_HOST=
INFORMIX_SERVICE=1545
INFORMIX_SERVER=
INFORMIX_DATABASE=
INFORMIX_PROTOCOL=onsoctcp
INFORMIX_DRIVER_PATH=/opt/IBM/informix/lib/cli/iclit09b.so

# Opcionales — SOLO si después de re-importar productos/categorías siguen
# viéndose mal las tildes/ñ (el código ya repara el caso más común solo).
# Fuerzan el locale GLS que usa el cliente Informix al conectar; tienen que
# coincidir con el locale real del servidor (preguntar al admin del ERP, o
# probar con es_es.CP1252 / es_es.8859-1, que es lo típico en LatAm).
# INFORMIX_CLIENT_LOCALE=es_es.CP1252
# INFORMIX_DB_LOCALE=es_es.CP1252

# Menú del huésped (QR). Los ítems internos del ERP (daños, recargos,
# cortesías, etc.) ya se ocultan solos. Opcionales:
# - Palabras extra a ocultar (separadas por coma, sin importar tildes/mayúsculas):
# GUEST_MENU_HIDE_KEYWORDS=lavanderia,llave
# - Mostrar solo productos que tengan foto (útil para demos):
# GUEST_MENU_ONLY_WITH_IMAGE=false
