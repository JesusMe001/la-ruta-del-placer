# Ruta relativa: en desarrollo Vite reenvía /api al backend (ver vite.config.js),
# así funciona igual en localhost, en la red local y a través de un túnel.
# En producción, el servidor web (nginx) debe reenviar /api al backend.
VITE_API_URL=/api

# Opcional: a qué backend reenvía Vite las llamadas /api en desarrollo.
# Por defecto http://localhost:3000. Para trabajar contra otro backend
# (por ejemplo, el túnel de quien tiene el backend corriendo):
# VITE_PROXY_TARGET=https://xxxx.trycloudflare.com
